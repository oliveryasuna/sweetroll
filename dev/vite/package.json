{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@sweetroll/dev-vite",
  "version": "1.0.0",
  "engines": {
    "bun": "1.3.10"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "./dist",
    "./package.json"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "postinstall": "syncpack format",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.1",
    "vite": "8.0.1",
    "vite-plugin-dts": "4.5.4",
    "vite-tsconfig-paths": "6.1.1"
  },
  "devDependencies": {
    "@sweetroll/dev-eslint": "workspace:*",
    "@sweetroll/dev-tsdown": "workspace:*"
  }
}
