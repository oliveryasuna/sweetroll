{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@sweetroll/fomod-ui",
  "version": "1.0.0",
  "engines": {
    "bun": "1.3.10"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "./dist",
    "./package.json"
  ],
  "scripts": {
    "build": "tsdown",
    "build-storybook": "storybook build",
    "lint": "eslint .",
    "postinstall": "syncpack format",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run"
  },
  "dependencies": {
    "@sweetroll/fomod": "workspace:*",
    "react": "19.2.6"
  },
  "devDependencies": {
    "@storybook/react": "10.3.6",
    "@storybook/react-vite": "10.3.6",
    "@sweetroll/dev-eslint": "workspace:*",
    "@sweetroll/dev-tsdown": "workspace:*",
    "@types/react": "19.2.14",
    "storybook": "10.3.6"
  }
}
