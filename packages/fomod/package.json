{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@sweetroll/fomod",
  "version": "1.0.0",
  "engines": {
    "bun": "1.3.10"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "./dist",
    "./package.json"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "postinstall": "syncpack format",
    "test": "vitest run"
  },
  "dependencies": {
    "fast-xml-parser": "5.7.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@sweetroll/dev-eslint": "workspace:*",
    "@sweetroll/dev-tsdown": "workspace:*"
  }
}
